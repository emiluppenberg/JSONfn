@page "/"

<PageTitle>JSONfn - Easy code from JSON</PageTitle>

<div class="page">

  <div class="w-full flex flex-col flex-1 items-center overflow-y-auto space-y-10 scroll-smooth">

    <Cookie Page="home" />

    <header>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 560 150" role="img" aria-labelledby="title desc">
        <title id="title">JSONfn() logo</title>
        <desc id="desc">Tight stylized JSONfn function-call text logo using blue and cyan colors inspired by the
          reference image.</desc>
          <defs>
            <linearGradient id="textGradient" x1="24" y1="28" x2="536" y2="124" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#10b0d0" />
              <stop offset="0.34" stop-color="#0080c0" />
              <stop offset="0.7" stop-color="#0060b0" />
              <stop offset="1" stop-color="#005090" />
            </linearGradient>
            <filter id="softShadow" x="-4%" y="-16%" width="108%" height="138%">
              <feDropShadow dx="0" dy="7" stdDeviation="5" flood-color="#003d66" flood-opacity="0.18" />
            </filter>
          </defs>

          <rect x="6" y="6" width="548" height="138" rx="28" fill="#f7fcff" />

          <text x="285" y="80" filter="url(#softShadow)" text-anchor="middle" dominant-baseline="middle"
                fill="url(#textGradient)" font-family="Inter, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="130"
                font-weight="820" letter-spacing="-7">JSON<tspan font-weight="650" font-style="italic" letter-spacing="-9">fn
          </tspan>
          <tspan font-size="104" font-weight="520" letter-spacing="12" fill="#10b0d0">()</tspan>
        </text>
      </svg>

      <h1 class="text-center text-xl font-medium my-2 text-cyan-400 select-none">Easy code from JSON</h1>

      <div
        class="flex flex-col min-w-50 md:min-w-200 space-y-2 md:space-y-5 leading-relaxed text-cyan-400 text-sm md:text-base">
        <div class="flex px-5 justify-evenly md:h-5 select-none">
          <p class="text-center md:text-start italic">
            Visualize JSON
          </p>

          <p class="text-center md:text-start italic">
            Pick properties
          </p>

          <p class="text-center md:text-start italic">
            Generate clean, configurable code
          </p>
        </div>
        <div class="flex flex-col md:flex-row md:justify-around min-w-full md:h-15">
          <p class="font-light text-white text-xs self-center">
            Fast and clutter-free classes/interfaces/types/zodschemas.<br />
            Supported languages: <strong>C#</strong>, <strong>TypeScript</strong><br />
          </p>
          <article
            class="mt-5 md:mt-0 flex flex-col self-center md:self-auto p-2 h-15 w-50 md:w-100 bg-(--bg-primary) text-white text-[0.5rem] overflow-y-auto">
            <div class="flex flex-col h-auto space-y-2">
              <div class="flex space-x-2">
                <p>31/01</p>
                <p class="text-wrap wrap-anywhere">Fixed bug which prevented JSON with kebab-case keys from parsing</p>
              </div>
              <div class="flex space-x-2">
                <p>15/02</p>
                <p class="text-wrap wrap-anywhere">C# support for backing fields, customizing get/set, customizing
                  public/private
                </p>
              </div>
              <div class="flex space-x-2">
                <p>15/02</p>
                <p class="text-wrap wrap-anywhere">C# handles plural naming for collections grammatically</p>
              </div>
              <div class="flex space-x-2">
                <p>15/02</p>
                <p class="text-wrap wrap-anywhere">Added copy-to-clipboard button</p>
              </div>
            </div>
          </article>
        </div>
      </div>
    </header>

    <div class="flex justify-center w-full h-auto">
      <div id="home-ad-desktop-1"></div>
      <div id="home-ad-desktop-2"></div>
      <div id="home-ad-mobile-1"></div>
    </div>

  </div>

  <NavLink
    class="w-full h-12 font-medium text-3xl italic text-center text-white p-1 bg-(--bluebutton) hover:bg-(--bluebutton-h) active:scale-95"
    href="tool">Go
  </NavLink>

</div>