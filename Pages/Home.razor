@page "/"

<PageTitle>JSONfn - Easy code from JSON</PageTitle>

<div class="page home-page">

  <div class="home-content">

    @* <Cookie Page="home" /> *@

    <header class="home-hero">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 560 150" role="img" aria-labelledby="title desc">
        <title id="title">JSONfn() logo</title>
        <desc id="desc">Tight stylized JSONfn function-call text logo using blue and cyan colors inspired by the
          reference image.</desc>
          <defs>
            <linearGradient id="textGradient" x1="24" y1="28" x2="536" y2="124" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#10b0d0" />
              <stop offset="0.34" stop-color="#0080c0" />
              <stop offset="0.7" stop-color="#0060b0" />
              <stop offset="1" stop-color="#005090" />
            </linearGradient>
            <filter id="softShadow" x="-4%" y="-16%" width="108%" height="138%">
              <feDropShadow dx="0" dy="7" stdDeviation="5" flood-color="#003d66" flood-opacity="0.18" />
            </filter>
          </defs>

          <rect x="6" y="6" width="548" height="138" rx="28" fill="#f7fcff" />

          <text x="285" y="80" filter="url(#softShadow)" text-anchor="middle" dominant-baseline="middle"
                fill="url(#textGradient)" font-family="Inter, Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-size="130"
                font-weight="820" letter-spacing="-7">JSON<tspan font-weight="650" font-style="italic" letter-spacing="-9">fn
          </tspan>
          <tspan font-size="104" font-weight="520" letter-spacing="12" fill="#10b0d0">()</tspan>
        </text>
      </svg>

      <h1 class="home-title">Easy code from JSON</h1>

      <div
        class="home-details">
        <div class="home-steps">
          <p>
            Visualize JSON
          </p>

          <p>
            Pick properties
          </p>

          <p>
            Generate clean, configurable code
          </p>
        </div>
        <div class="home-summary">
          <p class="home-description">
            Fast and clutter-free classes/interfaces/types/zodschemas.<br />
            Supported languages: <strong>C#</strong>, <strong>TypeScript</strong><br />
          </p>
          <article
            class="home-changelog">
            <div class="home-changelog-list">
              <div class="home-changelog-entry">
                <p>31/01</p>
                <p>Fixed bug which prevented JSON with kebab-case keys from parsing</p>
              </div>
              <div class="home-changelog-entry">
                <p>15/02</p>
                <p>C# support for backing fields, customizing get/set, customizing
                  public/private
                </p>
              </div>
              <div class="home-changelog-entry">
                <p>15/02</p>
                <p>C# handles plural naming for collections grammatically</p>
              </div>
              <div class="home-changelog-entry">
                <p>15/02</p>
                <p>Added copy-to-clipboard button</p>
              </div>
            </div>
          </article>
        </div>
      </div>
    </header>

    @* <div class="home-ads">
      <div id="home-ad-desktop-1"></div>
      <div id="home-ad-desktop-2"></div>
      <div id="home-ad-mobile-1"></div>
    </div> *@

  </div>

  <NavLink
    class="home-go"
    href="tool">Go
  </NavLink>

</div>
