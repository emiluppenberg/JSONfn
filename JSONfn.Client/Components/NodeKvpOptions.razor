@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="transition-opt option-marker @Transition @BackgroundColor @StickyClass">
</div>
<div tabindex="0" @ref="Ref"
     class="transition-opt option-panel @Transition @ParentHover @HoverColor @OutlineColor @BackgroundColor @StickyClass @(NodeTypeToggled ? "option-type-open" : "")">

  @if (Kvp is not null)
  {
    @if (Kvp.IsArray())
    {
      <CollectionSelection LangOptions="LangOptions" CollectionItemNullable="Kvp.CollectionItemNullable"
                           CollectionItemAllowUndefined="Kvp.CollectionItemAllowUndefined" Target="@Target" CurrentSelected="@Kvp.CollectionAs"
                           OnSelected="@(async arg => await ForwardSetKvpCollection.InvokeAsync(arg))"
                           OnSetCollectionItemNullable="async () => await ForwardSetKvpCollectionItemNullable.InvokeAsync()"
                           OnSetCollectionItemAllowUndefined="async () => await ForwardSetKvpCollectionItemAllowUndefined.InvokeAsync()"
                           IsToggled="KvpCollectionToggled" OnToggled="HandleKvpCollectionToggled" />
    }
    <button class="option-setting"
            @onclick="async () => await ForwardSetKvpNullable.InvokeAsync()">
      <label class="option-setting-label">Nullable</label>
      <input class="option-setting-checkbox" type="checkbox" disabled @bind="Kvp.Nullable" />
    </button>
    @if (LangOptions.Language == "TypeScript")
    {
      <button class="option-setting"
              @onclick="async () => await ForwardSetKvpOptional.InvokeAsync()">
        <label class="option-setting-label">Optional</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Kvp.Optional" />
      </button>
      <button class="option-setting"
              @onclick="async () => await ForwardSetKvpAllowUndefined.InvokeAsync()">
        <label class="option-setting-label option-setting-label-compact">Allow undefined</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Kvp.AllowUndefined" />
      </button>
    }
    @if (LangOptions.Language == "C#")
    {
      <AnnotationKeySelection LangOptions="LangOptions" Target="@Target" Kvp="Kvp"
                              ForwardOnAnnotationSelected="async arg => await ForwardSetKvpAnnotation.InvokeAsync(arg)" />
      <button class="option-setting"
              @onclick="async () => await ForwardSetKvpIsPrivate.InvokeAsync()">
        <label class="option-setting-label">IsPrivate</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Kvp.IsPrivate" />
      </button>
      <button class="option-setting"
              @onclick="async () => await ForwardSetKvpHasField.InvokeAsync()">
        <label class="option-setting-label">HasField</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Kvp.HasField" />
      </button>
      <button class="option-setting"
              @onclick="async () => await ForwardSetKvpHasGet.InvokeAsync()">
        <label class="option-setting-label">HasGet</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Kvp.HasGet" />
      </button>
      <button class="option-setting"
              @onclick="async () => await ForwardSetKvpHasSet.InvokeAsync()">
        <label class="option-setting-label">HasSet</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Kvp.HasSet" />
      </button>
    }
  }

  @if (Node is not null && Node.Parent is not null)
  {
    @if (Node.Type == JNodeType.Array)
    {
      <CollectionSelection LangOptions="LangOptions" CollectionItemNullable="Node.CollectionItemNullable"
                           CollectionItemAllowUndefined="Node.CollectionItemAllowUndefined" Target="@Target"
                           CurrentSelected="@Node.CollectionAs" OnSelected="@(async arg => await ForwardSetNodeCollection.InvokeAsync( arg))"
                           OnSetCollectionItemNullable="async () => await ForwardSetNodeCollectionItemNullable.InvokeAsync()"
                           OnSetCollectionItemAllowUndefined="async () => await ForwardSetNodeCollectionItemAllowUndefined.InvokeAsync()"
                           IsToggled="NodeCollectionToggled" OnToggled="HandleNodeCollectionToggled" />
    }
    <button class="option-setting"
            @onclick="async () => await ForwardSetNodeNullable.InvokeAsync()">
      <label class="option-setting-label">Nullable</label>
      <input class="option-setting-checkbox" type="checkbox" disabled @bind="Node.Nullable" />
    </button>
    @if (LangOptions.Language == "TypeScript")
    {
      <button class="option-setting"
              @onclick="async () => await ForwardSetNodeOptional.InvokeAsync()">
        <label class="option-setting-label">Optional</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Node.Optional" />
      </button>
      <button class="option-setting"
              @onclick="async () => await ForwardSetNodeAllowUndefined.InvokeAsync()">
        <label class="option-setting-label option-setting-label-compact">Allow undefined</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Node.AllowUndefined" />
      </button>
      <button class="option-setting"
              @onclick="async () => await ForwardSetNodeZodSchema.InvokeAsync()">
        <label class="option-setting-label option-setting-label-compact">ZodSchema</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Node.TypeOption!.UseZodSchema" />
      </button>
      <TypeSelection Types="Language.GetTypeOptions()" Target="@Target" CurrentSelected="@Node.TypeOption!.Name"
                     OnSelected="@(async arg => await ForwardSetNodeTypeOption.InvokeAsync(arg))" IsToggled="NodeTypeToggled"
                     OnToggled="HandleNodeTypeToggled" />
      @if (Node.TypeOption!.Name == "class")
      {
        <button class="option-setting option-class-constructor"
                @onclick="async () => await ForwardSetNodeClassPrimaryConstructor.InvokeAsync()">
          <label class="option-setting-label option-setting-label-compact">Primary constructor</label>
          <input class="option-setting-checkbox" type="checkbox" disabled
                 @bind="Node.TypeOption!.UsePrimaryConstructor" />
        </button>
        <button class="option-setting option-class-constructor"
                @onclick="async () => await ForwardSetNodeClassRegularConstructor.InvokeAsync()">
          <label class="option-setting-label option-setting-label-compact">Regular constructor</label>
          <input class="option-setting-checkbox" type="checkbox" disabled
                 @bind="Node.TypeOption!.UseRegularConstructor" />
        </button>
      }
    }
    @if (LangOptions.Language == "C#")
    {
      <AnnotationKeySelection LangOptions="LangOptions" Target="@Target" Node="Node"
                              ForwardOnAnnotationSelected="async arg => await ForwardSetNodeAnnotation.InvokeAsync(arg)" />
      <button class="option-setting"
              @onclick="async () => await ForwardSetNodeIsPrivate.InvokeAsync()">
        <label class="option-setting-label">IsPrivate</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Node.IsPrivate" />
      </button>
      <button class="option-setting"
              @onclick="async () => await ForwardSetNodeHasField.InvokeAsync()">
        <label class="option-setting-label">HasField</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Node.HasField" />
      </button>
      <button class="option-setting"
              @onclick="async () => await ForwardSetNodeHasGet.InvokeAsync()">
        <label class="option-setting-label">HasGet</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Node.HasGet" />
      </button>
      <button class="option-setting"
              @onclick="async () => await ForwardSetNodeHasSet.InvokeAsync()">
        <label class="option-setting-label">HasSet</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Node.HasSet" />
      </button>
    }
  }

  @if (Node is not null && Node.Parent is null)
  {
    @if (Node.Type == JNodeType.Array)
    {
      <CollectionSelection LangOptions="LangOptions" CollectionItemNullable="Node.CollectionItemNullable"
                           CollectionItemAllowUndefined="Node.CollectionItemAllowUndefined" Target="@Target"
                           CurrentSelected="@Node.CollectionAs" OnSelected="@(async arg => await ForwardSetNodeCollection.InvokeAsync( arg))"
                           OnSetCollectionItemNullable="async () => await ForwardSetNodeCollectionItemNullable.InvokeAsync()"
                           OnSetCollectionItemAllowUndefined="async () => await ForwardSetNodeCollectionItemAllowUndefined.InvokeAsync()"
                           IsToggled="NodeCollectionToggled" OnToggled="HandleNodeCollectionToggled" />
    }
    @if (LangOptions.Language == "TypeScript")
    {
      <button class="option-setting"
              @onclick="async () => await ForwardSetNodeOptional.InvokeAsync()">
        <label class="option-setting-label">Optional</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Node.Optional" />
      </button>
      <button class="option-setting"
              @onclick="async () => await ForwardSetNodeAllowUndefined.InvokeAsync()">
        <label class="option-setting-label option-setting-label-compact">Allow undefined</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Node.AllowUndefined" />
      </button>
      <button class="option-setting"
              @onclick="async () => await ForwardSetNodeZodSchema.InvokeAsync()">
        <label class="option-setting-label option-setting-label-compact">ZodSchema</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Node.TypeOption!.UseZodSchema" />
      </button>
      <TypeSelection Types="Language.GetTypeOptions()" Target="@Target" CurrentSelected="@Node.TypeOption!.Name"
                     OnSelected="@(async arg => await ForwardSetNodeTypeOption.InvokeAsync(arg))" IsToggled="NodeTypeToggled"
                     OnToggled="HandleNodeTypeToggled" />
      @if (Node.TypeOption!.Name == "class")
      {
        <button class="option-setting option-class-constructor"
                @onclick="async () => await ForwardSetNodeClassPrimaryConstructor.InvokeAsync()">
          <label class="option-setting-label option-setting-label-compact">Primary constructor</label>
          <input class="option-setting-checkbox" type="checkbox" disabled
                 @bind="Node.TypeOption!.UsePrimaryConstructor" />
        </button>
        <button class="option-setting option-class-constructor"
                @onclick="async () => await ForwardSetNodeClassRegularConstructor.InvokeAsync()">
          <label class="option-setting-label option-setting-label-compact">Regular constructor</label>
          <input class="option-setting-checkbox" type="checkbox" disabled
                 @bind="Node.TypeOption!.UseRegularConstructor" />
        </button>
      }
    }
    @if (LangOptions.Language == "C#")
    {
      <AnnotationKeySelection LangOptions="LangOptions" Target="@Target" Node="Node"
                              ForwardOnAnnotationSelected="async arg => await ForwardSetNodeAnnotation.InvokeAsync(arg)" />
      <button class="option-setting"
              @onclick="async () => await ForwardSetNodeIsPrivate.InvokeAsync()">
        <label class="option-setting-label">IsPrivate</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Node.IsPrivate" />
      </button>
      <button class="option-setting"
              @onclick="async () => await ForwardSetNodeHasField.InvokeAsync()">
        <label class="option-setting-label">HasField</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Node.HasField" />
      </button>
      <button class="option-setting"
              @onclick="async () => await ForwardSetNodeHasGet.InvokeAsync()">
        <label class="option-setting-label">HasGet</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Node.HasGet" />
      </button>
      <button class="option-setting"
              @onclick="async () => await ForwardSetNodeHasSet.InvokeAsync()">
        <label class="option-setting-label">HasSet</label>
        <input class="option-setting-checkbox" type="checkbox" disabled @bind="Node.HasSet" />
      </button>
    }
  }
</div>

@code {
  [Parameter]
  public required ILanguageOptions LangOptions { get; set; }
  [Parameter]
  public JNode? Node { get; set; }
  [Parameter]
  public JNodeKvp? Kvp { get; set; }
  [Parameter]
  public required string Target { get; set; }
  [Parameter]
  public required string ParentHover { get; set; }

  private bool KvpCollectionToggled;
  private bool NodeTypeToggled;
  private bool NodeCollectionToggled;

  private string Transition = "is-collapsed-x";
  private ElementReference Ref;
  private DotNetObjectReference<NodeKvpOptions>? DotNetRef;
  [Parameter]
  public EventCallback OnClose { get; set; }

  [Parameter]
  public EventCallback ForwardSetKvpNullable { get; set; }
  [Parameter]
  public EventCallback ForwardSetKvpOptional { get; set; }
  [Parameter]
  public EventCallback ForwardSetKvpAllowUndefined { get; set; }
  [Parameter]
  public EventCallback<string> ForwardSetKvpCollection { get; set; }
  [Parameter]
  public EventCallback ForwardSetKvpCollectionItemNullable { get; set; }
  [Parameter]
  public EventCallback ForwardSetKvpCollectionItemAllowUndefined { get; set; }
  [Parameter]
  public EventCallback<KeyValuePair<string, string>> ForwardSetKvpAnnotation { get; set; }
  [Parameter]
  public EventCallback ForwardSetKvpIsPrivate { get; set; }
  [Parameter]
  public EventCallback ForwardSetKvpHasField { get; set; }
  [Parameter]
  public EventCallback ForwardSetKvpHasGet { get; set; }
  [Parameter]
  public EventCallback ForwardSetKvpHasSet { get; set; }

  [Parameter]
  public EventCallback ForwardSetNodeNullable { get; set; }
  [Parameter]
  public EventCallback ForwardSetNodeOptional { get; set; }
  [Parameter]
  public EventCallback ForwardSetNodeAllowUndefined { get; set; }
  [Parameter]
  public EventCallback<string> ForwardSetNodeCollection { get; set; }
  [Parameter]
  public EventCallback ForwardSetNodeCollectionItemNullable { get; set; }
  [Parameter]
  public EventCallback ForwardSetNodeCollectionItemAllowUndefined { get; set; }
  [Parameter]
  public EventCallback<ITypeScriptTypeOption> ForwardSetNodeTypeOption { get; set; }
  [Parameter]
  public EventCallback ForwardSetNodeClassPrimaryConstructor { get; set; }
  [Parameter]
  public EventCallback ForwardSetNodeClassRegularConstructor { get; set; }
  [Parameter]
  public EventCallback ForwardSetNodeZodSchema { get; set; }
  [Parameter]
  public EventCallback<KeyValuePair<string, string>> ForwardSetNodeAnnotation { get; set; }
  [Parameter]
  public EventCallback ForwardSetNodeIsPrivate { get; set; }
  [Parameter]
  public EventCallback ForwardSetNodeHasField { get; set; }
  [Parameter]
  public EventCallback ForwardSetNodeHasGet { get; set; }
  [Parameter]
  public EventCallback ForwardSetNodeHasSet { get; set; }

  private string BackgroundColor = null!;
  private string OutlineColor = null!;
  private string HoverColor = null!;
  private string StickyClass = "";
  private bool IsToggled = false;

  void HandleKvpCollectionToggled()
  {
    KvpCollectionToggled = !KvpCollectionToggled;
    NodeCollectionToggled = false;
    NodeTypeToggled = false;
  }

  void HandleNodeCollectionToggled()
  {
    NodeCollectionToggled = !NodeCollectionToggled;
    KvpCollectionToggled = false;
    NodeTypeToggled = false;
  }

  void HandleNodeTypeToggled()
  {
    NodeTypeToggled = !NodeTypeToggled;
    NodeCollectionToggled = false;
    KvpCollectionToggled = false;
  }

  [JSInvokable]
  public async Task OnClickOutside()
  {
    Transition = "is-collapsed-x";
    await InvokeAsync(StateHasChanged);
    await Task.Delay(50);
    await OnClose.InvokeAsync();
  }

  protected override async Task OnInitializedAsync()
  {
    if (Target == "kvp")
    {
      BackgroundColor = "option-tone-kvp";
      OutlineColor = "option-outline-kvp";
      HoverColor = "option-hover-kvp";
    }
    if (Target == "node")
    {
      BackgroundColor = "option-tone-node";
      OutlineColor = "option-outline-node";
      HoverColor = "option-hover-node";
    }
    if (Target == "sticky")
    {
      BackgroundColor = "option-tone-sticky";
      OutlineColor = "option-outline-sticky";
      HoverColor = "option-hover-sticky";
      StickyClass = "option-sticky-offset";
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      await Task.Delay(50);
      Transition = "is-expanded-x";
      StateHasChanged();

      DotNetRef = DotNetObjectReference.Create(this);
      await JS.InvokeVoidAsync(
      "registerClickOutside",
      Ref,
      DotNetRef);
    }
  }

  public async ValueTask DisposeAsync()
  {
    if (DotNetRef is not null)
    {
      await JS.InvokeVoidAsync("unregisterClickOutside", Ref);
      DotNetRef.Dispose();
    }
  }
}
