<div class="option-submenu-anchor">
  <div
    class="option-submenu @(IsToggled ? $"is-open option-outline-hover {OutlineColor}" : "") @StickyClass"
    @onclick="async () => await OnToggled.InvokeAsync()">
    <button class="option-submenu-trigger">@CurrentSelected</button>
    @if (IsToggled)
    {
      @foreach (var option in Collection)
      {
        <button
          class="option-submenu-choice @BackgroundColor @(option.ToString() == CurrentSelected ? $"{SelectedColor} option-choice-selected-text" : "")"
          @onclick="async () => await OnSelected.InvokeAsync(option.ToString())" @onclick:stopPropagation="true">
          @option.ToString()
        </button>
      }
      <button class="option-submenu-choice option-submenu-check @BackgroundColor"
        @onclick="async () => await OnSetCollectionItemNullable.InvokeAsync()" @onclick:stopPropagation="true">
        <label class="option-setting-label option-setting-label-compact">Allow null items</label>
        <input type="checkbox" class="option-setting-checkbox" @bind="CollectionItemNullable" />
      </button>
      @if (LangOptions.Language == "TypeScript")
      {
        <button class="option-submenu-choice option-submenu-check @BackgroundColor"
          @onclick="async () => await OnSetCollectionItemAllowUndefined.InvokeAsync()" @onclick:stopPropagation="true">
          <label class="option-setting-label option-setting-label-compact">Allow undefined items</label>
          <input type="checkbox" class="option-setting-checkbox" @bind="CollectionItemAllowUndefined" />
        </button>
      }
    }
  </div>
</div>

@code {
  [Parameter]
  public required ILanguageOptions LangOptions { get; set; }
  [Parameter]
  public bool? CollectionItemNullable { get; set; }
  [Parameter]
  public bool? CollectionItemAllowUndefined { get; set; }
  [Parameter]
  public required string Target { get; set; }
  [Parameter]
  public required string CurrentSelected { get; set; }
  [Parameter]
  public bool IsToggled { get; set; }

  [Parameter]
  public EventCallback OnToggled { get; set; }
  [Parameter]
  public EventCallback<string> OnSelected { get; set; }
  [Parameter]
  public EventCallback OnSetCollectionItemNullable { get; set; }
  [Parameter]
  public EventCallback OnSetCollectionItemAllowUndefined { get; set; }

  private Array Collection { get; set; } = null!;
  private string StickyClass = "";
  private string BackgroundColor = null!;
  private string OutlineColor = null!;
  private string SelectedColor = null!;

  protected override void OnInitialized()
  {
    Collection = LangOptions.GetCollectionOptions();

    if (Target == "kvp")
    {
      BackgroundColor = "option-tone-kvp-selected";
      SelectedColor = "option-tone-kvp-active";
      OutlineColor = "option-outline-kvp";
    }
    if (Target == "node")
    {
      BackgroundColor = "option-tone-node-selected";
      SelectedColor = "option-tone-node-active";
      OutlineColor = "option-outline-node";
    }
    if (Target == "sticky")
    {
      BackgroundColor = "option-tone-sticky-selected";
      SelectedColor = "option-tone-sticky-active";
      OutlineColor = "option-outline-sticky";
    }
  }
}
