<div class="option-submenu-anchor">
  <div
    class="option-submenu @(IsToggled ? $"is-open option-outline-hover {OutlineColor}" : "")"
    @onclick="async () => await OnToggled.InvokeAsync()">
    <button class="option-submenu-trigger">@CurrentSelected</button>
    @if (IsToggled)
    {
      @foreach (var option in Types)
      {
        <button
          class="option-submenu-choice @BackgroundColor @(option.Name == CurrentSelected ? "option-tone-choice-active" : "")"
          @onclick="async () => await OnSelected.InvokeAsync(option)" @onclick:stopPropagation="true">
          @option.Name
        </button>
      }
    }
  </div>
</div>

@code {
  [Parameter]
  public required List<ITypeScriptTypeOption> Types { get; set; }
  [Parameter]
  public required string CurrentSelected { get; set; }
  [Parameter]
  public required string Target { get; set; }
  [Parameter]
  public bool IsToggled { get; set; }

  [Parameter]
  public EventCallback OnToggled { get; set; }
  [Parameter]
  public EventCallback<ITypeScriptTypeOption> OnSelected { get; set; }

  private string StickyClass = "";
  private string BackgroundColor = null!;
  private string OutlineColor = null!;


  protected override void OnInitialized()
  {
    if (Target == "sticky")
    {
      OutlineColor = "option-outline-sticky";
      BackgroundColor = "option-tone-sticky-selected";
    }
    if (Target == "node")
    {
      OutlineColor = "option-outline-node";
      BackgroundColor = "option-tone-node-selected";
    }
  }
}
