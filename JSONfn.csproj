<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="JSONfn.Client\JSONfn.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="JSONfn.Client\**\*.cs" />
    <Content Remove="JSONfn.Client\**\*" />
    <EmbeddedResource Remove="JSONfn.Client\**\*" />
    <None Remove="JSONfn.Client\**\*" />
    <RazorComponent Remove="JSONfn.Client\**\*.razor" />
  </ItemGroup>

</Project>
